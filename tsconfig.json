{
    "compilerOptions": {
        "lib": ["ES2022", "DOM"],
        "target": "ES2022",
        "module": "ESNext",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "paths": {
            "@surrealdb/sql-internal/testing": ["./packages/internal/src/testing"],
            "@surrealdb/sql-internal": ["./packages/internal/src"],
            "@surrealdb/pg": ["./packages/pg/src"],
            "@surrealdb/mysql/callback": ["./packages/mysql/src/compat/callback.ts"],
            "@surrealdb/mysql": ["./packages/mysql/src"]
        }
    },
    "include": ["packages/*/src", "packages/*/test", "vitest.config.ts"]
}
