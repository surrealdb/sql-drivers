{
    "name": "sql-drivers",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "bun run --filter './packages/*' build",
        "test": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "test:compat": "vitest run --project compat",
        "size": "size-limit",
        "qc": "biome check .",
        "qa": "biome check . --write",
        "qts": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@size-limit/file": "14.3.0",
        "@types/node": "26.6.5",
        "size-limit": "14.3.0",
        "tsup": "9.0.0",
        "typescript": "5.9.3",
        "vitest": "5.0.5"
    },
    "packageManager": "bun@1.4.4"
}
